<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cotizacion_card_bg"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvProducto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Producto"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/cotizacion_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnEliminar"
        app:layout_constraintHorizontal_bias="0" />

    <ImageButton
        android:id="@+id/btnEliminar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="@android:color/transparent"
        app:tint="#B0BEC5"
        android:contentDescription="Eliminar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvPresentacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Presentación"
        android:textSize="13sp"
        android:textColor="@color/cotizacion_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tvProducto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnEliminar"
        app:layout_constraintHorizontal_bias="0"
        android:paddingTop="2dp" />

    <!-- Badge de cantidad: reemplaza el "Cantidad: X" en texto plano de antes -->
    <TextView
        android:id="@+id/tvCantidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="x1"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/cotizacion_primary"
        android:background="@drawable/cotizacion_pill_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPresentacion"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/tvPrecioUnitario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="P. Unit"
        android:textSize="13sp"
        android:textColor="@color/cotizacion_text_secondary"
        app:layout_constraintBottom_toTopOf="@id/tvPrecioTotal"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/tvPrecioTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Precio Total"
        android:textStyle="bold"
        android:textSize="17sp"
        android:textColor="@color/cotizacion_money"
        app:layout_constraintTop_toBottomOf="@id/tvCantidad"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
